#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
using vll = vector<ll>;
 
void solve()
{
    ll n, x;
    cin >> n >> x;
    string s;
    cin >> s;
    x--;
    ll t1 = -1, t2 = n;
    for (int i = 0; i < x; i++)
        if (s[i] == '#')
        {
            t1 = i;
        }
    for (int i = n - 1; i > x; i--)
    {
        if (s[i] == '#')
            t2 = i;
    }
    ll left = t1 + 1, right = n - t2;
    ll ans = min(left, right);
    for (int i = t1 + 1; i < x; i++)
    {
        ll left = i + 1, right = n - t2;
        ll mini = min(left, right);
        ans = max(ans, mini);
    }
    for (int i = x + 1; i < t2; i++)
    {
        ll left = t1 + 1, right = n - i;
        ll mini = min(left, right);
        ans = max(ans, mini);
    }
 
    cout << ans + 1 << endl;
}
int main()
{
    ll t;
    cin >> t;
    while (t--)
    {
 
        solve();
    }
    return 0;
}